# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
build/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*

# Runtime
.DS_Store
*.pem
.turbo/

# Docker
data/

# Deployment-specific Prometheus targets — populated by setup wizard
config/prometheus/targets/nodes.json
config/prometheus/targets/pve.json
config/prometheus/targets/intel-gpu.json
config/prometheus/targets/nvidia.json
config/prometheus/targets/ceph.json

# Contains the Proxmox API token — never commit
config/pve-exporter/pve.yml
config/prometheus/targets/*.json

# Local DB/config dumps — sits next to the encrypted credential store
backups/

# Bearer token for the plug-in metrics scrape — generated per install
config/prometheus/secrets/*
!config/prometheus/secrets/.gitkeep

# TypeScript incremental build cache. Machine-specific, rewritten by every
# build, and it embeds absolute paths from whoever built last.
*.tsbuildinfo
