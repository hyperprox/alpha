{
  "uid": "hyperprox-cluster",
  "title": "HyperProx — Cluster Overview",
  "tags": [
    "hyperprox"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage — All Nodes",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "100 - (avg by(node) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory Usage — All Nodes",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network I/O — All Nodes",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(node_network_receive_bytes_total{device=\"vmbr0\"}[5m])",
          "legendFormat": "{{node}} ↓"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(node_network_transmit_bytes_total{device=\"vmbr0\"}[5m])",
          "legendFormat": "{{node}} ↑"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "binBps"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Disk Usage — Root Filesystem",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"}) * 100",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "Intel GPUs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Intel GPU — Engine Utilization",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "igpu_engines_render_3d_0_busy",
          "legendFormat": "{{node}} Render/3D"
        },
        {
          "datasource": "Prometheus",
          "expr": "igpu_engines_video_0_busy",
          "legendFormat": "{{node}} Video"
        },
        {
          "datasource": "Prometheus",
          "expr": "igpu_engines_blitter_0_busy",
          "legendFormat": "{{node}} Blitter"
        },
        {
          "datasource": "Prometheus",
          "expr": "igpu_engines_video_enhance_0_busy",
          "legendFormat": "{{node}} VideoEnhance"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Intel GPU — Memory Bandwidth",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "igpu_imc_bandwidth_reads",
          "legendFormat": "{{node}} Reads"
        },
        {
          "datasource": "Prometheus",
          "expr": "igpu_imc_bandwidth_writes",
          "legendFormat": "{{node}} Writes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MBs"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Intel GPU — Power Draw",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "igpu_power_gpu",
          "legendFormat": "{{node}} GPU"
        },
        {
          "datasource": "Prometheus",
          "expr": "igpu_power_package",
          "legendFormat": "{{node}} Package"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Intel GPU — Frequency",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "igpu_frequency_actual",
          "legendFormat": "{{node}} Actual"
        },
        {
          "datasource": "Prometheus",
          "expr": "igpu_frequency_requested",
          "legendFormat": "{{node}} Requested"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "megahertz"
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "AMD GPUs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "AMD GPU — Utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "node_drm_gpu_busy_percent",
          "legendFormat": "{{node}} GPU%"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "AMD GPU — VRAM Usage",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "node_drm_memory_vram_used_bytes / 1024 / 1024 / 1024",
          "legendFormat": "{{node}} Used (GB)"
        },
        {
          "datasource": "Prometheus",
          "expr": "node_drm_memory_vram_size_bytes / 1024 / 1024 / 1024",
          "legendFormat": "{{node}} Total (GB)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes"
        }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "NVIDIA GPUs",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "NVIDIA GPU — Utilization",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "nvidia_smi_utilization_gpu_ratio * 100",
          "legendFormat": "{{node}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "NVIDIA GPU — Memory",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "nvidia_smi_memory_used_bytes / 1024 / 1024 / 1024",
          "legendFormat": "{{node}} Used (GB)"
        },
        {
          "datasource": "Prometheus",
          "expr": "nvidia_smi_memory_total_bytes / 1024 / 1024 / 1024",
          "legendFormat": "{{node}} Total (GB)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "NVIDIA GPU — Power Draw",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "nvidia_smi_power_draw_watts",
          "legendFormat": "{{node}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "NVIDIA GPU — Temperature",
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "nvidia_smi_temperature_gpu",
          "legendFormat": "{{node}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "description": "Template. HyperProx writes provisioning/dashboards/hyperprox-cluster.json from it with only the GPU rows for the vendors your nodes have (packages/hardware/dashboard.js)."
}
