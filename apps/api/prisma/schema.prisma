generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Cluster config ----------------------------------------------------------

model ProxmoxCluster {
  id          String   @id @default(uuid())
  name        String   @default("TitanCluster")
  host        String
  port        Int      @default(8006)
  tokenId     String
  tokenSecret String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  nodes       Node[]
}

model Node {
  id         String         @id @default(uuid())
  clusterId  String
  cluster    ProxmoxCluster @relation(fields: [clusterId], references: [id])
  name       String         // e.g. "node1"
  ip         String
  roles      String[]       @default([])
  online     Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// --- Proxy -------------------------------------------------------------------
// One row per proxy instance added on the Proxy page (lib/proxy). No secrets: those are in the vault,
// one item per instance (hyperprox:proxy-instance/<id>). The legacy NPM login in Settings is not a row.
// Replaces the unused ProxyProvider/ProxyHost tables (dropped by 20261104140000_proxy_instances).

model ProxyInstance {
  id        String   @id
  kind      String              // npm | traefik | caddy | haproxy | pangolin
  name      String
  url       String
  mode      String   @default("byo")   // byo | managed
  managed   Json?               // { node, vmid, recipe } when the Catalogue installed it
  settings  Json                // non-secret options per kind
  owned     Json     @default("[]")   // host ids HyperProx created here (Caddy, HAProxy, Pangolin)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- DNS ---------------------------------------------------------------------

model DNSProvider {
  id        String      @id @default(uuid())
  type      String      // godaddy | cloudflare | namecheap
  name      String
  apiKey    String
  apiSecret String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  records   DNSRecord[]
}

model DNSRecord {
  id         String      @id @default(uuid())
  providerId String
  provider   DNSProvider @relation(fields: [providerId], references: [id])
  type       String      // A | CNAME | TXT | MX
  name       String
  value      String
  ttl        Int         @default(3600)
  domain     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// --- Setup -------------------------------------------------------------------

model SetupState {
  id          String   @id @default("singleton")
  completed   Boolean  @default(false)
  currentStep Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Audit log ---------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  resource  String
  details   Json?
  createdAt DateTime @default(now())
}

// --- API tokens --------------------------------------------------------------
// Bearer tokens for automation (lib/api-tokens.ts). Only the SHA-256 of a token
// is stored; the token itself is shown once, at creation. A revoked token keeps
// its row (and its name) so the audit log still resolves.

model ApiToken {
  id         String    @id @default(cuid())
  name       String    @unique
  role       String    // viewer | operator | admin
  tokenHash  String    @unique   // sha256 hex of the full token
  createdBy  String              // creator's email, or "host-cli"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
}

// --- Credentials (encrypted) ------------------------------------------------

model Credential {
  id        String   @id @default(uuid())
  category  String   // proxmox | proxy_npm | dns_godaddy | system
  provider  String   // npm | godaddy | cloudflare | proxmox | hyperprox
  key       String   // field name e.g. NPM_URL, PROXMOX_HOST
  value     String   // AES-256-GCM encrypted
  masked    Boolean  @default(true)  // should UI mask this field?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, provider, key])
}

// --- Terminal layouts --------------------------------------------------------

model TerminalLayout {
  id        String   @id @default(uuid())
  name      String   @unique
  view      String   @default("tabs")   // tabs | cols | rows | grid
  panes     Json     // [{ hostId, name, address, port }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Updates -----------------------------------------------------------------
// One row per run of the Updates feature (lib/updates). Status and action are
// strings, matching the shared Updates* types in @hyperprox/types.

model UpdateJob {
  id          String       @id @default(cuid())
  trigger     String       // manual | schedule | dry-run
  status      String       // planned | awaiting-confirm | running | paused | failed | done | cancelled
  pauseReason String?
  plan        Json
  report      Json?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  steps       UpdateStep[]

  @@index([startedAt])
}

model UpdateStep {
  id        String    @id @default(cuid())
  jobId     String
  job       UpdateJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  seq       Int
  target    String    // node name or vmid
  action    String    // preflight | refresh | snapshot | apt | docker | check | ceph | node-upgrade | node-reboot | kernel-cleanup | self
  status    String    // pending | running | ok | failed | skipped
  detail    String?
  reason    String?
  output    String?   // tail of captured output
  startedAt DateTime?
  endedAt   DateTime?

  @@index([jobId, seq])
}

// At most one row, id "updates": the job that currently holds the one-job-at-a-time lock.
model UpdateLock {
  id        String   @id
  jobId     String
  createdAt DateTime @default(now())
}

// --- Certificates ------------------------------------------------------------
// Metadata for the Certificates feature (lib/certs). Private keys, certificate
// PEMs and the ACME account key live in the vault, never here.

model ManagedCertificate {
  id          String       @id @default(cuid())
  label       String       @unique   // policy key under `certificates:`
  names       String[]
  status      String                 // pending | valid | renewing | failed
  issuer      String?
  serial      String?
  fingerprint String?                // SHA-256 of the current leaf: what every deploy must see served
  notBefore   DateTime?
  notAfter    DateTime?
  ariStart    DateTime?
  ariEnd      DateTime?
  renewAfter  DateTime?              // decided time, ARI or two-thirds
  staging     Boolean      @default(false)
  lastError   String?
  issuedAt    DateTime?
  updatedAt   DateTime     @updatedAt
  events      CertEvent[]
  targets     CertTarget[]
}

// The last delivery of a certificate to one policy target.
model CertTarget {
  id           String             @id @default(cuid())
  certId       String
  cert         ManagedCertificate @relation(fields: [certId], references: [id], onDelete: Cascade)
  name         String             // policy key under `targets:`
  kind         String             // guest-files | hyperprox
  lastDeployAt DateTime?
  ok           Boolean?
  detail       String?
  fingerprint  String?            // the leaf that delivery was for

  @@unique([certId, name])
}

model CertProbe {
  id          String    @id @default(cuid())
  host        String
  port        Int
  starttls    String              // none | smtp | imap | pop3
  source      String              // policy | proxy | node | managed
  internal    Boolean   @default(false)
  checkedAt   DateTime?
  verdict     String?             // ok | warn | critical | error
  reason      String?
  fingerprint String?
  issuer      String?
  notAfter    DateTime?
  trusted     Boolean?
  namesMatch  Boolean?

  @@unique([host, port])
}

model CertEvent {
  id     String              @id @default(cuid())
  certId String?
  cert   ManagedCertificate? @relation(fields: [certId], references: [id], onDelete: SetNull)
  label  String?
  kind   String              // issue | renew | deploy | probe | housekeeping | alert
  ok     Boolean
  detail String
  at     DateTime            @default(now())

  @@index([at])
  @@index([label, at])
}

// Small named values the daily check carries between runs (alert state, last check time).
model CertState {
  id        String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// --- Notifications -----------------------------------------------------------
// Channels and delivery history for lib/notify. No secret is stored here: a
// channel's webhook URL or token is a vault item (hyperprox:notify/<id>), or,
// for a channel marked usable while locked, in data/notify-locked-channels.json.

model NotifyChannel {
  id                String    @id
  name              String
  kind              String              // discord | slack | teams | ntfy | gotify | telegram | webhook
  enabled           Boolean   @default(true)
  minSeverity       String    @default("warning")   // info | warning | critical
  eventFilter       Json                // "all" or a list of families
  quietHours        Json?
  lanOverride       Boolean   @default(false)       // "Self-hosted on my network"
  usableWhileLocked Boolean   @default(false)
  private           Boolean   @default(false)       // trusted readers only: receives sign-in links
  nonSecret         Json                // e.g. { chatId } for Telegram
  lastResult        Json?               // { ok, status?, code?, at }
  lastSentAt        DateTime?
  failingSince      DateTime?
  seededFrom        String?             // lock-alert | updates | certs
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// One row per event per channel: the queue, and the delivery history (pruned after 30 days).
model NotifyOutbox {
  id            String    @id @default(uuid())
  eventId       String
  channelId     String
  type          String
  severity      String
  fingerprint   String?
  resolved      Boolean   @default(false)
  payload       Json                // the scrubbed message, never a secret or a log
  status        String              // queued | held-quiet | held-locked | sent | failed | dropped
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  httpStatus    Int?
  errorCode     String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([channelId, createdAt])
}

// Small named values (which old settings have been moved onto channels).
model NotifyState {
  id        String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
//  Remote access (lib/remote): what HyperProx installed where. Nothing secret.
// -----------------------------------------------------------------------------

model RemoteAccessDevice {
  id          String    @id @default(cuid())
  machineId   String    // node-<name> | lxc-<id> | qemu-<id> | host-<id>
  provider    String    // tailscale | netbird
  deviceId    String?   // the provider's device or peer id
  nodeKey     String?   // Tailscale's stable node id
  hostname    String?
  address     String?   // overlay address
  mode        String    @default("kernel")   // kernel | userspace
  version     String?
  routes      String[]
  exitNode    Boolean   @default(false)
  routeIds    String[]  // NetBird routes HyperProx created
  adopted     Boolean   @default(false)   // already there; HyperProx only recorded it
  forwardingBefore String?               // a guest's "v4:v6" forwarding before routing went on
  prefs       Json?     // the client's own settings as last read back (no secrets)
  connected   Boolean?
  checkedAt   DateTime?
  lastError   String?
  installedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([machineId, provider])
}

// Every key that has left HyperProx and is not yet confirmed revoked. The key id only, never the key.
model RemoteAccessPendingRevoke {
  id          String   @id @default(cuid())
  provider    String
  keyId       String
  revokeAfter DateTime
  reason      String   // install | manual
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())

  @@index([revokeAfter])
}

// A change on a node that started and has not passed its guard yet. Found after a restart: re-check, roll back.
model RemoteAccessInflight {
  id        String   @id @default(cuid())
  machineId String
  provider  String
  action    String
  jobId     String
  by        String
  owner     String
  before    Json
  undo      Json
  startedAt DateTime @default(now())
}

// The Catalogue install wizard: previews, install jobs and "ID being created" marks, so an API restart
// does not orphan a container that was mid-install. The record itself is JSON; expiresAt drives pruning.
model CatalogueRecord {
  id        String    @id
  kind      String              // preview | job | creating
  owner     String
  data      Json
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([kind, expiresAt])
}

// Devices the VPN poller has already seen at each provider, so a new one is announced once, restart or not.
model RemoteAccessKnownDevice {
  provider  String
  deviceId  String
  firstSeen DateTime @default(now())

  @@id([provider, deviceId])
}

// -----------------------------------------------------------------------------
//  WireGuard (lib/vpn/wireguard): servers and peers HyperProx manages. Public keys only: a client's private
//  key and config are vault items; a server's or machine's private key stays on that machine.
// -----------------------------------------------------------------------------

model WgServer {
  id          String   @id @default(cuid())
  machineId   String
  iface       String
  listenPort  Int
  address     String   // the server's tunnel address and pool, e.g. 192.0.2.1/24
  endpoint    String   // host:port clients connect to
  publicKey   String
  keyBackedUp Boolean  @default(false)   // the owner chose to keep a copy of the server key in the vault
  createdAt   DateTime @default(now())

  @@unique([machineId, iface])
}

model WgPeer {
  id                String    @id @default(cuid())
  serverId          String?
  routerIface       String?
  routerPeerId      String?
  kind              String    // device | machine
  name              String
  machineId         String?
  iface             String?
  publicKey         String
  address           String
  allowedIps        String[]
  clientAllowedIps  String[]
  keepalive         Int?
  previousPublicKey String?
  previousUntil     DateTime?
  rotatedAt         DateTime?
  createdAt         DateTime  @default(now())
}
