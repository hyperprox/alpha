{
  "compilerOptions": {
    "target":             "ES2017",
    "lib":                ["dom", "dom.iterable", "esnext"],
    "allowJs":            true,
    "skipLibCheck":       true,
    "strict":             true,
    "noEmit":             true,
    "esModuleInterop":    true,
    "module":             "esnext",
    "moduleResolution":   "bundler",
    "resolveJsonModule":  true,
    "isolatedModules":    true,
    "jsx":                "preserve",
    "incremental":        true,
    "plugins":            [{ "name": "next" }],
    "paths": {
      "@/*":               ["./*"],
      "@hyperprox/types":  ["../../packages/types/src/index.ts"],
      "@local-plugins":    ["./local-plugins/index.ts", "./lib/local-plugins-none.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next-demo/types/**/*.ts"],
  "exclude": ["node_modules"]
}
