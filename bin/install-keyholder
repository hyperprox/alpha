#!/usr/bin/env bash
# HyperProx — install or refresh the keyholder service. Run by install.sh and deploy.sh; safe to re-run.
#
# The keyholder (bin/hyperprox-keyholder) holds the unlocked vault state in memory so that restarting the
# API, which every deploy does, does not lock HyperProx. Restarting the KEYHOLDER locks HyperProx, so:
#   - it is started if it is not running, and otherwise left alone;
#   - it is restarted only when its own program changed, and this script says so first.
# It also gives hyperprox-api a drop-in (Wants/After the keyholder, VAULT_KEYHOLDER_SOCKET), which takes
# effect at the API's next restart. Nothing here restarts the API.
#
# Overridable for testing on a scratch unit name: KEYHOLDER_UNIT, API_UNIT, SYSTEMD_DIR, KEYHOLDER_LIB.
set -euo pipefail

HYPERPROX_DIR="${HYPERPROX_DIR:-/opt/hyperprox}"
UNIT="${KEYHOLDER_UNIT:-hyperprox-keyholder.service}"
API_UNIT="${API_UNIT:-hyperprox-api.service}"
SYSTEMD_DIR="${SYSTEMD_DIR:-/etc/systemd/system}"
LIB="${KEYHOLDER_LIB:-/usr/local/lib/hyperprox}"
RUNDIR="${UNIT%.service}"
SRC="${HYPERPROX_DIR}/bin/hyperprox-keyholder"
DEST="${LIB}/hyperprox-keyholder"
SOCKET="/run/${RUNDIR}/keyholder.sock"

PY="$(command -v python3 || true)"
if [[ -z "$PY" ]]; then
  echo "✗ The keyholder needs python3 (standard library only). Install it: apt-get install -y python3" >&2
  exit 1
fi
[[ -f "$SRC" ]] || { echo "✗ ${SRC} is missing" >&2; exit 1; }

# The keyholder only talks to the API's user, inside the API's unit.
API_USER="$(systemctl show -p User --value "$API_UNIT" 2>/dev/null || true)"
API_USER="${API_USER:-root}"
API_UID="$(id -u "$API_USER")"

program_changed=0
first_install=0
mkdir -p "$LIB"; chmod 0755 "$LIB"
if [[ ! -f "$DEST" ]]; then
  first_install=1
fi
if [[ ! -f "$DEST" ]] || ! cmp -s "$SRC" "$DEST"; then
  [[ -f "$DEST" ]] && program_changed=1
  install -m 0755 "$SRC" "${DEST}.new"
  mv -f "${DEST}.new" "$DEST"
fi

unit_text() {
  cat <<EOF
[Unit]
Description=HyperProx keyholder (holds the unlocked vault state in memory)
# deploy.sh never restarts this service (only when its program changes, and it says so first):
# restarting it LOCKS HyperProx. It keeps no state on disk; a stop or crash means locked.
Before=${API_UNIT}

[Service]
Type=notify
NotifyAccess=main
User=root
ExecStart=${PY} ${DEST} --socket ${SOCKET} --allow-uid ${API_UID} --allow-unit ${API_UNIT}
RuntimeDirectory=${RUNDIR}
RuntimeDirectoryMode=0700
Restart=always
RestartSec=2
UMask=0077
# What it holds must never reach a disk: no core dumps, no swap.
LimitCORE=0
MemorySwapMax=0
# A unix socket only: no network at all.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=${RUNDIR}

[Install]
WantedBy=multi-user.target
EOF
}

dropin_text() {
  cat <<EOF
# Written by bin/install-keyholder. The API keeps the unlocked state in the keyholder, so restarting the
# API does not lock HyperProx. Wants (not Requires): restarting the keyholder must not restart the API.
[Unit]
Wants=${UNIT}
After=${UNIT}

[Service]
Environment=VAULT_KEYHOLDER_SOCKET=${SOCKET}
EOF
}

reload=0
unit_changed=0
write_if_changed() {   # path, text
  local path="$1" text="$2"
  if [[ ! -f "$path" ]] || [[ "$(cat "$path")" != "$text" ]]; then
    mkdir -p "$(dirname "$path")"
    printf '%s\n' "$text" > "${path}.new"
    chmod 0644 "${path}.new"
    mv -f "${path}.new" "$path"
    reload=1
    return 0
  fi
  return 1
}

if write_if_changed "${SYSTEMD_DIR}/${UNIT}" "$(unit_text)"; then unit_changed=1; fi
write_if_changed "${SYSTEMD_DIR}/${API_UNIT}.d/keyholder.conf" "$(dropin_text)" || true
[[ "$reload" == "1" ]] && systemctl daemon-reload
systemctl enable "$UNIT" --quiet

if ! systemctl is-active --quiet "$UNIT"; then
  systemctl start "$UNIT"
  echo "  keyholder started (${UNIT})"
  if [[ "$first_install" == "1" ]]; then
    echo "  ⚠ First install of the keyholder: the API restart that follows locks HyperProx ONE last time."
    echo "    From the next deploy on, an API restart keeps HyperProx unlocked."
  fi
elif [[ "$program_changed" == "1" ]]; then
  echo "  ⚠ The keyholder program changed. Restarting it now LOCKS HyperProx (and sends the lock alert):"
  echo "    sign in again afterwards."
  systemctl restart "$UNIT"
  echo "  keyholder restarted: HyperProx is locked"
else
  echo "  keyholder unchanged and running: left alone (HyperProx stays unlocked across this deploy)"
  if [[ "$unit_changed" == "1" ]]; then
    echo "  note: its unit file changed; that takes effect at its next restart, which will lock HyperProx"
  fi
fi
