# HyperProx public demo: the demo frontend (next start), on loopback only.
# The front service (hyperprox-demo.service) is the only thing that talks to it. See docs/demo.md.
[Unit]
Description=HyperProx public demo - frontend (loopback)
After=network-online.target

[Service]
Type=simple
User=hpxdemo
Group=hpxdemo
WorkingDirectory=/opt/hyperprox-demo/app/apps/frontend
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HYPERPROX_NEXT_DIST=.next-demo HYPERPROX_API_PORT=3102
# Refuse every outbound connection from this process too (apps/api/src/demo/no-outbound.ts).
Environment=NODE_OPTIONS=--require=/opt/hyperprox-demo/app/apps/api/dist-demo/demo/no-outbound-register.js
ExecStart=/opt/hyperprox-demo/app/apps/frontend/node_modules/.bin/next start -p 3100 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
# No MemoryDenyWriteExecute: Node's JIT needs writable, executable memory.
ReadWritePaths=/opt/hyperprox-demo/app/apps/frontend/.next-demo/cache
MemoryMax=900M

[Install]
WantedBy=multi-user.target
